// Portway build settings shared by every target.
//
// Identifiers and the team live here; the panel URL does NOT. Put machine-local and secret
// values in Config/Local.xcconfig (git-ignored) — see Config/Local.example.xcconfig.

PORTWAY_BUNDLE_ID = app.portway.ios
PORTWAY_APP_GROUP = group.$(PORTWAY_BUNDLE_ID)
PORTWAY_IMPORT_SCHEME = portway
PORTWAY_FALLBACK_DNS = 1.1.1.1
PORTWAY_PANEL_URL =
// The one-device session protocol (register/claim/heartbeat/release). The panel confirmed the
// iOS wire shape against its stored rows (mikrotik-manager db8041e). See PANEL.md.
PORTWAY_SESSION_PROTOCOL = YES
DEVELOPMENT_TEAM =

MARKETING_VERSION = 1.0.0
CURRENT_PROJECT_VERSION = 1

#include? "Local.xcconfig"
